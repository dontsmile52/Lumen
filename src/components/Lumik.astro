---
// Lumik, inlined so he can blink: awake, his eyes close for a moment every few seconds; `sleepy` shows him asleep
// until hovered.
import { lumikAsleep, lumikAwake } from '../lib/lumik';

interface Props {
  /** Unique on the page: the drawings' gradient ids are prefixed with it. */
  id: string;
  size: number;
  /** Asleep, waking up while the pointer is over him (or his `group`). */
  sleepy?: boolean;
  class?: string;
}
const { id, size, sleepy = false, class: className = '' } = Astro.props;
const awake = lumikAwake(id, `width="${size}" height="${size}"`);
const asleep = sleepy ? lumikAsleep(id, `width="${size}" height="${size}"`) : '';
---
<span
  class:list={['lumik relative inline-block shrink-0', sleepy && 'lumik-sleepy', className]}
  style={`width:${size}px;height:${size}px`}
  role="img"
  aria-label="Люмик"
>
  <span class="lumik-awake absolute inset-0" set:html={awake} />
  {sleepy && <span class="lumik-asleep absolute inset-0" set:html={asleep} />}
</span>

<style>
  .lumik-awake, .lumik-asleep { transition: opacity 0.35s ease, transform 0.35s ease; }
  .lumik-sleepy .lumik-awake { opacity: 0; transform: scale(0.92); }
  .lumik-sleepy .lumik-asleep { opacity: 1; }
  /* Wakes up under the pointer, on his own or on the notch he sits in. */
  .lumik-sleepy:hover .lumik-awake, :global(.group:hover) .lumik-sleepy .lumik-awake,
  :global(.group:focus-visible) .lumik-sleepy .lumik-awake { opacity: 1; transform: scale(1); }
  .lumik-sleepy:hover .lumik-asleep, :global(.group:hover) .lumik-sleepy .lumik-asleep,
  :global(.group:focus-visible) .lumik-sleepy .lumik-asleep { opacity: 0; }
</style>
