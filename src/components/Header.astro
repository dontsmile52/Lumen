---
import Lumik from './Lumik.astro';
import { SITE } from '../config';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import appIcon from '../assets/app-icon.svg?raw';

interface Props { home: boolean }
const { home } = Astro.props;
const prefix = home ? '' : '/';
const links = [
  { href: `${prefix}#features`, label: 'Возможности' },
  { href: `${prefix}#pricing`, label: 'Цены' },
  { href: `${prefix}#faq`, label: 'FAQ' },
];
const icon = appIcon.replace('width="1024" height="1024"', 'width="28" height="28" aria-hidden="true"').replace(/<!--[\s\S]*?-->/g, '');
---
<header class="sticky top-0 z-40">
  <div class="absolute inset-0 -z-10 border-b border-border/60 bg-background/70 backdrop-blur-xl"></div>
  <!-- The notch: a black island at the top edge, Lumik asleep on its left; he wakes up under the pointer. -->
  <a
    href={`${prefix}#lumik`}
    class="group absolute left-1/2 top-0 -translate-x-1/2 items-center rounded-b-[18px] bg-black py-1.5 pl-2.5 pr-14 shadow-[0_8px_24px_-8px_rgb(0_0_0/0.6)] ring-1 ring-white/5 transition-[padding] duration-300 hover:pr-20 focus-visible:pr-20 flex"
    aria-label="Люмик в чёлке"
  >
    <Lumik id="notch-lumik" size={26} sleepy />
  </a>
  <nav class="section flex h-16 items-center justify-between gap-4" aria-label="Главное меню">
    <a href="/" class="flex items-center gap-2.5 font-display text-lg font-semibold tracking-tight" aria-label="Lumen — на главную">
      <span set:html={icon} class="flex" />
      <span style="font-family: var(--font-display)">Lumen</span>
    </a>
    <div class="flex items-center gap-1 sm:gap-2">
      <ul class="hidden items-center gap-1 md:flex">
        {links.map((link) => (
          <li><a href={link.href} class="rounded-full px-3 py-2 text-sm text-muted-foreground transition-colors hover:text-foreground">{link.label}</a></li>
        ))}
      </ul>
      <a
        href={SITE.download}
        data-goal="download_click"
        class={cn(buttonVariants({ size: 'pill-xs' }), 'ml-2 shadow-[0_6px_20px_-6px_var(--glow)]')}
      >Скачать</a>
    </div>
  </nav>
</header>
