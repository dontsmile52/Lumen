---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Lumik from '../components/Lumik.astro';
import Shot from '../components/Shot.astro';
import Features, { type Picture } from '../components/Features';
import ProBeam from '../components/ProBeam';
import { SITE } from '../config';
import { buttonVariants } from '@/components/ui/button';
import { badgeVariants } from '@/components/ui/badge';
import { cn } from '@/lib/utils';

// Screenshots of Lumen on test data (scripts in the app repository, never the owner's own files).
// Each is optional: until it exists, its place shows a placeholder saying what goes there.
const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/shots/*.{png,jpg}', { eager: true });
const shot = (name: string) => (shots[`../assets/shots/${name}.jpg`] ?? shots[`../assets/shots/${name}.png`])?.default;

async function picture(name: string, alt: string): Promise<Picture | undefined> {
  const source = shot(name);
  if (!source) return undefined;
  const image = await getImage({ src: source, widths: [480, 800, 1200], format: 'webp' });
  return { src: image.src, srcset: image.srcSet.attribute, width: source.width, height: source.height, alt };
}
const featureShots = {
  clipboard: await picture('clipboard', 'Панель истории буфера обмена Lumen'),
  folder: await picture('folder', 'Открытая папка в Lumen с эмодзи на иконке'),
};

const highlights = ['⌥Space или жест трекпада', 'Поиск по-русски', 'История буфера ⌘⇧V', 'Liquid Glass'];

const lumikPoints = [
  { title: 'Панель в чёлке', text: 'Клик по чёлке разворачивает панель: сверху быстрые переключатели — Люмик, буфер обмена, стиль, жест, — ниже все настройки Lumen. Отдельного окна настроек нет.' },
  { title: 'Не мешает', text: 'Спит и не тратит процессор. Выберите, где ему жить: во всех окнах, только на рабочем столе — или выключите. В полноэкранных приложениях он прячется сам.' },
  { title: 'Говорит коротко', text: 'Открыли лаунчер — Люмик просыпается и вылетает из чёлки. Скопировали — скажет «Поймал текст!» или «Поймал ссылку!», а что именно, не показывает.' },
  { title: 'И без чёлки', text: 'На Mac без выреза в экране Люмик живёт в маленькой капсуле по центру верхнего края.' },
];

const customize = [
  { title: 'Liquid Glass или плоский стиль', text: 'Стекло macOS Tahoe по умолчанию или спокойные плоские плашки — переключатель в настройках.' },
  { title: 'Свои обои и размытие', text: 'Фон — окна под Lumen, обои рабочего стола или своя картинка. Размытие и затемнение — от 0 до 100%.' },
  { title: 'Свои иконки', pro: true, text: 'PNG, JPG, ICNS или HEIC на любое приложение — в сетке, папках и поиске. Иконка в самой системе не меняется.' },
  { title: 'Размер сетки', text: 'Сколько столбцов и строк, какого размера иконки, нужны ли подписи под ними.' },
  { title: 'Скрытие приложений', pro: true, text: 'Уберите из сетки то, чем не пользуетесь: поиск по-прежнему их найдёт.' },
];

const reasons = [
  { title: 'Полностью на русском', text: 'Интерфейс, поиск, который понимает русские названия и неправильную раскладку, поддержка — всё по-русски. Английский тоже есть.' },
  { title: 'Российские карты и СБП', text: 'Pro оплачивается картой российского банка или через СБП на странице ЮKassa. Чек приходит на почту.' },
  { title: 'Ваше остаётся на Mac', text: 'История буфера и найденные файлы хранятся только на вашем Mac и никуда не отправляются. Анонимная статистика — только если вы разрешите.' },
  { title: 'Бесплатная версия — навсегда', text: 'Сетка, папки, поиск приложений, Люмик и буфер на 10 записей работают бесплатно и без срока.' },
];

const table = [
  ['Сетка, страницы, папки (имя и иконка)', '✓', '✓'],
  ['Поиск приложений', '✓', '✓'],
  ['Стиль, размытие, затемнение, своё фоновое изображение', '✓', '✓'],
  ['Буфер обмена', 'Текст и картинки, 10 записей, 7 дней', 'Всё, включая файлы, 1000 записей, 30 дней'],
  ['Поиск файлов', '—', '✓'],
  ['Скрытие приложений', '—', '✓'],
  ['Свои иконки приложений', '—', '✓'],
  ['Цена', '0 ₽', '149 ₽/мес или 990 ₽/год'],
];

const faq = [
  { q: 'На каких Mac работает Lumen?', a: 'На macOS 26 Tahoe и новее — и на Apple Silicon, и на Intel. Люмик живёт в чёлке MacBook, а на Mac без неё — в капсуле по центру верхнего края экрана.' },
  { q: 'Почему Lumen нет в App Store?', a: 'Lumen работает поверх всех окон и полноэкранных приложений, понимает жесты трекпада и вставляет запись из буфера по Enter. Приложениям из App Store так нельзя, поэтому Lumen скачивается с этого сайта, а обновления ставит сам.' },
  { q: 'Как открыть Lumen при первом запуске?', a: 'Lumen подписан нашим сертификатом, а не сертификатом Apple, поэтому macOS один раз спросит, доверяете ли вы ему. Это занимает минуту —', link: { href: '/install', label: 'пошаговая инструкция' } },
  { q: 'Это безопасно? Куда уходят мои данные?', a: 'История буфера обмена и найденные файлы хранятся только на вашем Mac. Lumen обращается к своему серверу за лицензией, пробным периодом и точным временем, проверяет обновления и — только если вы разрешили — раз в сутки отправляет анонимную статистику: сколько раз запускался Lumen и открывался лаунчер, версии Lumen и macOS. Названия приложений, содержимое буфера и файлы не отправляются никогда. Секретное из менеджеров паролей Lumen не запоминает.' },
  { q: 'Как отменить подписку?', a: 'В Lumen: настройки (клик по чёлке или ⌘,) → «Лицензия» → «Отменить подписку». Списаний больше не будет, а Pro проработает до конца оплаченного месяца.' },
  { q: 'Как вернуть деньги?', a: `Напишите в поддержку в Telegram ${SITE.telegramName} — поможем. Условия возврата описаны в`, link: { href: '/offer', label: 'публичной оферте' } },
  { q: 'Что будет, если я сменю Mac?', a: `Лицензия привязана к одному Mac. Чтобы перенести её на новый, напишите в Telegram ${SITE.telegramName}.` },
];
---
<Base
  home
  title="Lumen — лаунчер приложений для macOS 26 Tahoe"
  description="Все приложения Mac на одном экране, поиск, который понимает неправильную раскладку, история буфера обмена и Люмик в чёлке. Бесплатно, Pro — 149 ₽ в месяц."
>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden pt-14 sm:pt-20">
    <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-40 -z-10 mx-auto h-[520px] max-w-4xl rounded-full bg-[radial-gradient(closest-side,var(--glow),transparent)] blur-2xl"></div>
    <div class="section text-center">
      <p class="inline-flex items-center gap-2 rounded-full border border-border bg-card px-3 py-1 text-sm text-muted-foreground">
        <span class="size-1.5 rounded-full bg-primary"></span>Для macOS 26 Tahoe
      </p>
      <h1 class="mx-auto mt-6 max-w-4xl text-[1.7rem] leading-[1.15] font-bold text-balance min-[400px]:text-[2rem] sm:text-6xl">
        Все программы Mac —&nbsp;на&nbsp;одном экране
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-muted-foreground sm:text-xl">
        Lumen возвращает сетку приложений, как в Launchpad, и добавляет поиск, который понимает неправильную раскладку, историю буфера обмена и Люмика — светлячка, который живёт в чёлке.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href={SITE.download} data-goal="download_click" class={cn(buttonVariants({ size: 'pill' }), 'w-full shadow-[0_10px_30px_-10px_var(--glow)] sm:w-auto')}>Скачать бесплатно</a>
        <a href="#pricing" data-goal="buy_click" class={cn(buttonVariants({ variant: 'secondary', size: 'pill' }), 'glass w-full sm:w-auto')}>Купить Pro</a>
      </div>
      <p class="mt-3 text-sm text-muted-foreground">14 дней Pro бесплатно, без карты</p>
      <ul class="mx-auto mt-8 flex max-w-3xl flex-wrap items-center justify-center gap-x-3 gap-y-2 text-sm text-muted-foreground" aria-label="Главное">
        {highlights.map((item, index) => (
          <li class="flex items-center gap-3">
            {index > 0 && <span aria-hidden="true" class="text-border">|</span>}
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="section relative mt-12 sm:mt-16">
      <div class="absolute -top-10 right-8 z-10 sm:-top-14 sm:right-16">
        <Lumik id="hero-lumik" size={88} class="lumik-float drop-shadow-[0_10px_24px_var(--glow)]" />
      </div>
      <Shot src={shot('launcher')} alt="Лаунчер Lumen: сетка приложений на весь экран" todo="скриншот лаунчера целиком" eager />
    </div>
  </section>

  <!-- Lumik in the notch -->
  <section id="lumik" class="section mt-28 sm:mt-36">
    <div class="grid items-center gap-12 lg:grid-cols-[1fr_1.1fr]">
      <div>
        <p class="eyebrow">Новое в Lumen</p>
        <h2 class="mt-3 text-3xl font-bold sm:text-5xl">Люмик в&nbsp;чёлке</h2>
        <p class="mt-4 text-lg text-muted-foreground">Светлячок Lumen поселился в чёлке MacBook. Он показывает, что Lumen рядом, и прячет в чёлке все настройки.</p>
        <dl class="mt-8 grid gap-5 sm:grid-cols-2">
          {lumikPoints.map((point) => (
            <div>
              <dt class="font-semibold">{point.title}</dt>
              <dd class="mt-1 text-[15px] leading-relaxed text-muted-foreground">{point.text}</dd>
            </div>
          ))}
          <div class="sm:col-span-2">
            <dt class="flex items-center gap-2 font-semibold">Виджеты в панели <span class={cn(badgeVariants({ variant: 'outline' }), 'rounded-full text-muted-foreground')}>Скоро</span></dt>
            <dd class="mt-1 text-[15px] leading-relaxed text-muted-foreground">Полезные мелочи прямо в панели у чёлки.</dd>
          </div>
        </dl>
      </div>
      <div class="space-y-5">
        <Shot src={shot('notch-panel')} alt="Панель в чёлке: быстрые переключатели и настройки Lumen" todo="панель в чёлке" ratio="4 / 3" sizes="(min-width: 1024px) 600px, 100vw" />
        <Shot alt="Экран MacBook целиком: Люмик в чёлке" todo="Иван снимет экран MacBook целиком, Люмик спит в чёлке слева" ratio="16 / 10" />
      </div>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="section mt-28 sm:mt-36">
    <div class="max-w-2xl">
      <p class="eyebrow">Возможности</p>
      <h2 class="mt-3 text-3xl font-bold sm:text-5xl">Быстрее, чем искать в&nbsp;Dock</h2>
      <p class="mt-4 text-lg text-muted-foreground">Открываете Lumen — и сразу печатаете. Всё остальное он делает сам.</p>
    </div>
    <div class="mt-10">
      <Features client:visible {...featureShots} />
    </div>
    <div class="mt-6">
      <Shot src={shot('search')} alt="Поиск в Lumen: «ntktuhfv» нашёл Telegram" todo="поиск с исправлением раскладки" ratio="16 / 9" />
    </div>
  </section>

  <!-- Make it yours -->
  <section class="section mt-28 sm:mt-36">
    <div class="max-w-2xl">
      <p class="eyebrow">Настройка</p>
      <h2 class="mt-3 text-3xl font-bold sm:text-5xl">Сделай Lumen своим</h2>
    </div>
    <div class="mt-10 grid gap-5 lg:grid-cols-2">
      <Shot src={shot('launcher')} alt="Lumen в стиле Liquid Glass" todo="лаунчер, стиль Liquid Glass" sizes="(min-width: 1024px) 560px, 100vw" />
      <Shot src={shot('style-flat')} alt="Lumen в плоском стиле" todo="лаунчер, плоский стиль" sizes="(min-width: 1024px) 560px, 100vw" />
    </div>
    <ul class="mt-10 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
      {customize.map((item) => (
        <li>
          <h3 class="flex items-center gap-2 text-base font-semibold" style="font-family: var(--font-sans)">
            {item.title}
            {item.pro && <span class={cn(badgeVariants({ variant: 'secondary' }), 'rounded-full bg-accent text-accent-foreground')}>Pro</span>}
          </h3>
          <p class="mt-1 text-[15px] leading-relaxed text-muted-foreground">{item.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- Why Lumen -->
  <section class="section mt-28 sm:mt-36">
    <div class="max-w-2xl">
      <p class="eyebrow">Почему Lumen</p>
      <h2 class="mt-3 text-3xl font-bold sm:text-5xl">Сделан для тех, кто пишет по-русски</h2>
    </div>
    <ul class="mt-10 grid gap-4 sm:grid-cols-2">
      {reasons.map((reason) => (
        <li class="glass rounded-2xl p-6">
          <h3 class="text-lg font-semibold" style="font-family: var(--font-sans)">{reason.title}</h3>
          <p class="mt-2 text-[15px] leading-relaxed text-muted-foreground">{reason.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- Pricing -->
  <section id="pricing" class="section mt-28 sm:mt-36">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow">Цены</p>
      <h2 class="mt-3 text-3xl font-bold sm:text-5xl">Бесплатно — или Pro</h2>
      <p class="mt-4 text-lg text-muted-foreground">Первые 14 дней у вас Pro целиком — без регистрации и без карты. Потом решите сами.</p>
    </div>
    <div class="mx-auto mt-10 grid max-w-4xl gap-5 md:grid-cols-2">
      <article class="rounded-3xl border border-border bg-card p-7">
        <h3 class="text-xl font-semibold">Free</h3>
        <p class="mt-4"><span class="text-4xl font-bold" style="font-family: var(--font-display)">0 ₽</span> <span class="text-muted-foreground">навсегда</span></p>
        <p class="mt-3 text-[15px] text-muted-foreground">Сетка, папки, поиск приложений, Люмик и панель в чёлке, все стили. Буфер — 10 последних записей за 7 дней.</p>
        <a href={SITE.download} data-goal="download_click" class={cn(buttonVariants({ variant: 'outline', size: 'pill-sm' }), 'mt-7 w-full bg-transparent')}>Скачать бесплатно</a>
      </article>
      <article class="relative overflow-hidden rounded-3xl border border-primary/40 bg-card p-7 shadow-[0_30px_80px_-40px_var(--glow)]">
        <ProBeam client:visible />
        <h3 class="flex items-center gap-2 text-xl font-semibold">Pro <span class={cn(badgeVariants(), 'rounded-full')}>14 дней бесплатно</span></h3>
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          <div class="rounded-2xl bg-muted p-4">
            <p><span class="text-3xl font-bold" style="font-family: var(--font-display)">149 ₽</span> <span class="text-muted-foreground">/мес</span></p>
            <p class="mt-1 text-sm text-muted-foreground">Подписка. Отмена в программе в любой момент.</p>
          </div>
          <div class="rounded-2xl bg-muted p-4">
            <p><span class="text-3xl font-bold" style="font-family: var(--font-display)">990 ₽</span> <span class="text-muted-foreground">/год</span></p>
            <p class="mt-1 text-sm text-muted-foreground">Разовая оплата за год, без автосписаний.</p>
          </div>
        </div>
        <p class="mt-4 text-[15px] text-muted-foreground">Всё из Free, плюс полный буфер с файлами, поиск файлов, свои иконки и скрытие приложений.</p>
        <a href={SITE.download} data-goal="buy_click" class={cn(buttonVariants({ size: 'pill-sm' }), 'mt-6 w-full')}>Купить Pro</a>
        <p class="mt-3 text-center text-sm text-muted-foreground">Покупка — в самом Lumen: настройки → «Лицензия» → «Купить Pro». Pro включится сам, ключ придёт на почту.</p>
      </article>
    </div>

    <div class="mx-auto mt-10 max-w-4xl">
      <Shot src={shot('license')} alt="Вкладка «Лицензия» в настройках Lumen: покупка Pro прямо в программе" todo="вкладка «Лицензия»" ratio="4 / 3" sizes="(min-width: 1024px) 900px, 100vw" />
    </div>

    <div class="mx-auto mt-12 max-w-4xl overflow-hidden rounded-2xl border border-border">
      <table class="w-full text-left text-sm sm:text-[15px]">
        <caption class="sr-only">Чем отличаются Free и Pro</caption>
        <thead class="bg-muted text-sm">
          <tr><th scope="col" class="px-3 py-3 font-semibold sm:px-4">Функция</th><th scope="col" class="px-3 py-3 font-semibold sm:px-4">Free</th><th scope="col" class="px-3 py-3 font-semibold sm:px-4">Pro</th></tr>
        </thead>
        <tbody>
          {table.map(([feature, free, pro]) => (
            <tr class="border-t border-border">
              <th scope="row" class="w-[40%] px-3 py-3 font-normal sm:px-4">{feature}</th>
              <td class:list={['px-3 py-3 sm:px-4', free === '—' ? 'text-muted-foreground' : '']}>{free === '✓' ? <span aria-label="есть" class="text-brand">✓</span> : free === '—' ? <span aria-label="нет">—</span> : free}</td>
              <td class="px-3 py-3 sm:px-4">{pro === '✓' ? <span aria-label="есть" class="text-brand">✓</span> : pro}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- FAQ: native disclosure, so every answer is in the page and readable without JavaScript. -->
  <section id="faq" class="section mt-28 sm:mt-36">
    <div class="mx-auto max-w-3xl">
      <p class="eyebrow text-center">FAQ</p>
      <h2 class="mt-3 text-center text-3xl font-bold sm:text-5xl">Вопросы и ответы</h2>
      <div class="mt-10 divide-y divide-border border-y border-border">
        {faq.map((item) => (
          <details class="faq group" open>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-left text-[17px] font-medium">
              {item.q}
              <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 shrink-0 text-muted-foreground transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 9 6 6 6-6" /></svg>
            </summary>
            <p class="pb-5 text-[15px] leading-relaxed text-muted-foreground">
              {item.a}{item.link && <> <a class="text-brand underline underline-offset-4" href={item.link.href}>{item.link.label}</a>.</>}
            </p>
          </details>
        ))}
      </div>
      <!-- Without JavaScript every answer stays open and readable; with it the list folds into an accordion. -->
      <script is:inline>document.querySelectorAll('details.faq').forEach((item) => { item.open = false; });</script>
    </div>
  </section>

  <!-- Final call -->
  <section class="section mt-28 sm:mt-36">
    <div class="glass relative mx-auto max-w-4xl overflow-hidden rounded-[2rem] px-6 py-14 text-center sm:px-12">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(60%_80%_at_50%_0%,var(--glow),transparent)]"></div>
      <Lumik id="final-lumik" size={64} sleepy class="mx-auto" />
      <h2 class="mt-5 text-3xl font-bold sm:text-4xl">Люмик уже ждёт в&nbsp;чёлке</h2>
      <p class="mx-auto mt-3 max-w-xl text-muted-foreground">macOS 26 Tahoe и новее, Apple Silicon и Intel. 14 дней Pro бесплатно, дальше — бесплатная версия без срока или Pro.</p>
      <a href={SITE.download} data-goal="download_click" class={cn(buttonVariants({ size: 'pill' }), 'mt-8 px-8 shadow-[0_10px_30px_-10px_var(--glow)]')}>Скачать Lumen</a>
      <p class="mt-3 text-sm text-muted-foreground"><a class="underline underline-offset-4 hover:text-foreground" href="/install">Как открыть при первом запуске</a></p>
    </div>
  </section>
</Base>

<style>
  .faq summary::-webkit-details-marker { display: none; }
</style>
